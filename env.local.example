# Supabase project credentials.
# Find these in your Supabase project: Settings > API.
# Never commit this file (already covered by .gitignore).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ — this key bypasses RLS and
# must never reach the browser. Find it in Supabase project Settings > API
# (the "service_role" secret, not the "anon" key).
SUPABASE_SERVICE_ROLE_KEY=
